{
  "name": "mako-matcher",
  "version": "0.1.0",
  "private": true,
  "description": "Mako Market off-chain order matcher: a Cloudflare Worker that takes signed orders, keeps one book per market in a Durable Object, proposes matches, and serves the book feed. Phase A: intake, book, matching, feed. The settler is a stub that sends nothing.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run",
    "bundle": "wrangler deploy --dry-run --outdir dist",
    "assert-bundle": "node scripts/assert-bundle.mjs dist",
    "check:vendored": "node scripts/vendor.mjs --check",
    "test:scripts": "node --test scripts/assert-bundle.test.mjs scripts/vendor.test.mjs"
  },
  "dependencies": {
    "viem": "^2.47.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.13",
    "@cloudflare/workers-types": "^5.20260919.1",
    "typescript": "^5.9.3",
    "vitest": "~4.1.11",
    "wrangler": "^4.135.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
