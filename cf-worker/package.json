{
  "name": "mako-auto-resolver-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker that runs the Mako auto-resolver on a 1-minute cron. Replaces the drifty GitHub Actions scheduled workflow.",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail --format pretty",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "viem": "^2.47.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "typescript": "^5",
    "wrangler": "^4.0.0"
  }
}
