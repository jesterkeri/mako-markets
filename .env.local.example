# ─────────────────────────────────────────────────────────────────────────────
# Mako Markets — local environment template
#
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
# Values marked REQUIRED must be set before `pnpm dev` will work end-to-end.
# Values marked PHASE-1 become required during the Phase 1 onboarding rebuild
# (Magic + Safe + Pimlico + USDC) and can be left unset before then.
# ─────────────────────────────────────────────────────────────────────────────

# ── Contract + chain (REQUIRED) ─────────────────────────────────────────────
# Active MakoMarketsV4 contract on Monad testnet. v4 is USDC-denominated:
# placeBet pulls funds via IERC20.transferFrom, all amounts are 6-decimal
# USDC base units, and the front-end approves USDC to MakoMarkets before
# every first bet from a wallet.
#
# v4 testnet: 0xbC5A58487D7949dA2B76aC84AfC032fD0aa26195 (deployed 2026-05-18, redeploy w/ MIN_BET=0.10 USDC + creator seed + 7 market types + daily cap)
NEXT_PUBLIC_MAKO_ADDRESS="0xbC5A58487D7949dA2B76aC84AfC032fD0aa26195"

# First block where the active v4 contract was deployed. Used to bound event scans.
NEXT_PUBLIC_MAKO_DEPLOY_BLOCK="32603678"

# MakoPrivateMarketsV1 — three creator-defined private market shapes
# (Friendly / Open Vote / Prize Pool) alongside the public v4 markets above.
# See mako-private-markets-taxonomy.md and Phase 2 of the implementation plan.
#
# v1 testnet: 0xC9c6575a14D0e84afd5AB21C506916Fd2864bb8f (deployed 2026-05-09)
NEXT_PUBLIC_PRIVATE_MARKETS_ADDRESS="0xC9c6575a14D0e84afd5AB21C506916Fd2864bb8f"

# First block where the active v1 private-markets contract was deployed.
# Used by the Phase 2B indexer to bound event scans.
NEXT_PUBLIC_PRIVATE_MARKETS_DEPLOY_BLOCK="30685165"

# Feature flag: enable Private Markets surfaces (/create/private,
# /m/[slug], /api/pm/markets/draft, pm_* kinds at /api/aa/sponsor,
# PRIVATE column in HoverRevealPicker).
#
# /api/aa/send is intentionally NOT gated here — it has no `kind`
# in its request body ({ pendingUserOpId, signature } only), and
# the drain policy lets already-validated pm_* pending rows
# complete. See the [[mako-pm-gate]] memory + the inline note in
# src/app/api/aa/send/route.ts for the locked decision.
#
# Background hygiene NOT gated: cf-worker pm-indexer cron +
# /api/cron/pm-maintenance keep running so the DB stays warm and
# PM unlocks with a single env flip.
#
# Production: KEEP "false" until PM Phase 2E + 2F is verified
# end-to-end on Monad testnet (#165). Flip to "true" in Vercel
# Production + Preview when ready, then redeploy.
NEXT_PUBLIC_PM_ENABLED="false"

# USDC token address used by MakoMarketsV4.
# Monad testnet: 0x534b2f3A21130d7a60830c2Df862319e593943A3
# Production cutover: swap to Monad mainnet 0x754704Bc059F8C67012fEd69BC8A327a5aafb603
NEXT_PUBLIC_USDC_ADDRESS_MONAD_TESTNET="0x534b2f3A21130d7a60830c2Df862319e593943A3"

# Monad testnet RPC. Alchemy, QuickNode, or the public endpoint all work.
MONAD_RPC_URL=""

# ── RainbowKit / WalletConnect (REQUIRED) ───────────────────────────────────
# WalletConnect Cloud project id. Get one at https://cloud.walletconnect.com/
NEXT_PUBLIC_PROJECT_ID=""

# ── App URL (REQUIRED for share/broadcast links) ────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Admin SIWE session (REQUIRED for /admin/*) ──────────────────────────────
# 32-byte hex used to HMAC the admin session cookie.
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=""

# ── User session (PHASE-1 onboarding) ───────────────────────────────────────
# 32-byte hex used to HMAC the end-user session cookie (src/lib/user-session.ts).
# Generate with: openssl rand -hex 32
USER_SESSION_SECRET=""

# Phase 1G — TOTP 2FA secret encryption. AES-256-GCM key for
# users.totp_secret + pending_totp_enrollments.encrypted_secret. Distinct
# from USER_SESSION_SECRET so rotating one doesn't invalidate the other.
# Rotation procedure: docs/totp-key-rotation.md (added in Phase 1G).
# Generate with: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=""

# Allowlist gate stage. 'dev' allows every email through; 'beta' and
# 'production' require the email to be present in allowlist_emails.
# src/lib/allowlist.ts reads this.
MAKO_STAGE="dev"

# ── External data sources (OPTIONAL, soft-fail) ─────────────────────────────
# balldontlie NBA schedules — /create NBA tab + auto-resolver.
# Get a key at https://www.balldontlie.io/
BALLDONTLIE_API_KEY=""

# football-data.org fixtures — /create Football tab + auto-resolver.
# Free tier at https://www.football-data.org/
FOOTBALL_DATA_API_KEY=""

# ── Admin analytics tuning (OPTIONAL) ───────────────────────────────────────
# Parallelism ceiling for the event-log fanout that powers /admin/*.
ADMIN_ANALYTICS_CONCURRENCY="20"
# getLogs block chunk size on Monad testnet.
ADMIN_ANALYTICS_LOG_CHUNK="1000"

# ─────────────────────────────────────────────────────────────────────────────
# PHASE-1 onboarding rebuild — email + Safe + USDC + fiat onramp.
# Leave blank until Phase 1 wiring lands. See logical-dancing-liskov.md.
# ─────────────────────────────────────────────────────────────────────────────

# Magic.link publishable key (client) + secret (server).
NEXT_PUBLIC_MAGIC_PUBLISHABLE_KEY=""
MAGIC_SECRET_KEY=""

# Pimlico bundler + paymaster keys for Monad + Base.
# See docs/sponsor-cap-tuning.md for guidance on raising the per-op cap
# if first-bet 503s appear in production logs (Phase 1D bet flow).
PIMLICO_API_KEY_MONAD=""
PIMLICO_API_KEY_BASE=""

# Vercel Cron bearer for /api/cron/aa-fast + /api/cron/aa-slow.
# Generate with: openssl rand -hex 32
# Set in Vercel project env (production + preview) AND .env.local; Vercel
# injects `Authorization: Bearer ${CRON_SECRET}` on every scheduled cron
# invocation. The routes reject anything without a matching Bearer header.
# `x-vercel-cron` and `user-agent: vercel-cron/1.0` are diagnostic only —
# never used as authentication.
#
# Rotation procedure (run quarterly, or on suspected leak):
#   1. Generate a new secret: `openssl rand -hex 32`.
#   2. Update Vercel project env (production + preview) with the new value.
#   3. Trigger a redeploy so the new env propagates to all functions.
#   4. Verify cron logs show 200s under the new secret (one cron tick).
#   5. Remove the old secret from any local .env.local files.
# A formal runbook at docs/cron-secret-rotation.md will land as part of
# the Pre-Stage-1 hardening checklist (see plans/logical-dancing-liskov.md).
CRON_SECRET=""

# Alchemy address-activity webhooks — Monad + Base deposit detection.
ALCHEMY_WEBHOOK_SIGNING_SECRET=""
ALCHEMY_NOTIFY_TOKEN=""

# MoonPay business account.
MOONPAY_PUBLISHABLE_KEY=""
MOONPAY_SECRET_KEY=""
MOONPAY_WEBHOOK_SECRET=""

# Monnify (Naira virtual accounts).
MONNIFY_API_KEY=""
MONNIFY_SECRET_KEY=""
MONNIFY_CONTRACT_CODE=""
MONNIFY_WEBHOOK_SECRET=""

# Flutterwave (Naira payouts).
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_SECRET=""

# Smile Identity (BVN + selfie KYC).
SMILE_PARTNER_ID=""
SMILE_API_KEY=""
SMILE_WEBHOOK_SECRET=""

# Postgres (Drizzle). Auto-provisioned by Vercel Marketplace + Neon.
# Newer Vercel + Neon integrations expose DATABASE_URL; older first-party
# Vercel Postgres used POSTGRES_URL. Code accepts either.
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""
# Legacy aliases (older Vercel Postgres product) — still supported as fallback.
POSTGRES_URL=""
POSTGRES_PRISMA_URL=""
POSTGRES_URL_NO_SSL=""
POSTGRES_URL_NON_POOLING=""
POSTGRES_USER=""
POSTGRES_HOST=""
POSTGRES_PASSWORD=""
POSTGRES_DATABASE=""

# Vercel Blob — avatar image storage (Phase 1G avatar upload).
# Auto-provisioned when a Blob store is connected to the Vercel project;
# pull locally via `vercel env pull`.
BLOB_READ_WRITE_TOKEN=""

# ── Chart data provider — TwelveData (REQUIRED for #166 charts) ─────────────
# Historical OHLC for CRYPTO + FOREX + STOCKS on `/api/charts`.
# Commodities (XAU/XAG/XPT) use Stooq daily CSV — no key needed.
# Free tier: 8 req/min, 800/day. Sign up: https://twelvedata.com (email only).
#
# Server-only — DO NOT prefix with NEXT_PUBLIC. `src/lib/chart-providers/
# twelvedata.ts` imports `'server-only'` so a bundle leak would crash the
# client build, but the prefix discipline is the first line of defense.
TWELVEDATA_API_KEY=""
