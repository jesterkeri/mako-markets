{
  "extends": "../tsconfig.json",
  "compilerOptions": { "noUnusedLocals": false, "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"] },
  "include": ["./**/*.ts", "../src/**/*.ts"],
