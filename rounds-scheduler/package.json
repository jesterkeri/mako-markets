{
  "name": "mako-rounds-scheduler",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker that keeps Mako's own BTC rounds on the calendar: every 5 minutes it has the slot's house creator call MakoRoundsV1.schedule for the next upcoming 2-hour slots. Holds only the two house creator keys.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail --format pretty",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run && vitest run -c vitest.workers.config.ts",
    "bundle": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "viem": "2.56.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.13",
    "@cloudflare/workers-types": "5.20260919.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.135.0"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
