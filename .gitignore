# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# gstack security reports, learnings, and session state stay local.
.gstack/
.env*.local

# Operational handovers / playbooks: keep local only, don't track in git.
HANDOVER.md
HANDOVER*.md

# Claude scratch dir for in-flight plans, review notes, and draft artifacts.
# Contents are session-scoped, never shipped.
.claude-tmp/

# Operator audit log for ambiguous AA pending-op resolutions
# (scripts/resolve-ambiguous-op.mts). Local to the operator's machine.
.local-ops/
