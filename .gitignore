# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# gstack security reports, learnings, and session state stay local.
.gstack/
.env*.local

# Operational handovers / playbooks: keep local only, don't track in git.
HANDOVER.md
HANDOVER*.md

# Claude scratch dir for in-flight plans, review notes, and draft artifacts.
# Contents are session-scoped, never shipped.
.claude-tmp/
# Agent worktrees: `isolation: worktree` checks the whole repo out in here
# (hundreds of MB). Narrow on purpose, so a project-level .claude/agents or
# .claude/settings.json can still be committed.
/.claude/worktrees/

# Operator audit log for ambiguous AA pending-op resolutions
# (scripts/resolve-ambiguous-op.mts). Local to the operator's machine.
.local-ops/

# Local-only paid-services tracker (per Joshua's request)
/COSTS.md

# Local done ledger — per-machine audit of what's actually landed.
# Updated by Claude after every commit / deploy. See feedback memory
# [[feedback_local_done_ledger]] for the discipline.
/DONE.md

# Local task ledger — per-machine roadmap mirror of the numbered
# task list. Pending + in-progress at top, completed audit-trail
# below, V5 roadmap separate section. Numbers (#166, #185, …) are
# the canonical task IDs we reference across chat and commits.
/TASKS.md
